@model expense_tracker.Models.Account
@{
    ViewData["Title"] = "Account Details";
    var transactions = ViewBag.Transactions as IEnumerable<expense_tracker.Models.Transaction>;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 text-white" style="border-color: #444;">
        <i class="fa-solid fa-arrow-left me-2"></i> Back to List
    </a>
</div>

<div class="card border-0 mb-3 text-white shadow-sm" style="background-color: #212b36; border-radius: 15px;">
    <div class="card-body d-flex align-items-center p-3">
        
        <div class="fs-2 me-3 rounded-circle d-flex align-items-center justify-content-center"
             style="background-color: #1a222b; width: 60px; height: 60px;">
            @Model.Icon
        </div>
        <div>
            <h6 class="text-white-50 mb-0 small">Account Name</h6>
         
            <h4 class="mb-0 fw-bold">@Model.Title</h4>
            <div class="mt-1 fs-6">
                Balance: <span class="fw-bold @(Model.Balance >= 0 ? "text-success" : "text-danger")">
                    @Model.Balance.ToString("C0")
                </span>
            </div>
        </div>
    </div>
</div>

<h6 class="fw-bold mb-3 text-white"><i class="fa-solid fa-clock-rotate-left me-2"></i> Transaction History</h6>

@if (transactions != null && transactions.Any())
{
    <div class="card border-0" style="background-color: #212b36; border-radius: 15px;">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 small" style="background-color: transparent;">
                <thead>
                    <tr style="border-bottom: 1px solid #2c3e50;">
                        <th class="py-2 ps-4" style="background-color: #212b36; color: #adb5bd;">Date</th>
                        <th class="py-2" style="background-color: #212b36; color: #adb5bd;">Category</th>
                        <th class="py-2" style="background-color: #212b36; color: #adb5bd;">Note</th>
                        <th class="py-2 pe-4 text-end" style="background-color: #212b36; color: #adb5bd;">Amount</th>
                    </tr>
                </thead>
                <tbody style="border-top: none;">
                    @foreach (var item in transactions)
                    {
                        <tr style="border-bottom: 1px solid #2c3e50;">
                            <td class="ps-4">@item.Date.ToString("MM-dd-yy")</td>
                            <td>
                                <span class="badge px-2 py-1 rounded-pill" style="background-color: #1a222b; color: #fff; border: 1px solid #444;">
                                    @item.CategoryTitleWithIcon
                                </span>
                            </td>
                            <td class="text-white-50">@item.Note</td>
                            <td class="pe-4 text-end fw-bold @(item.Category?.Type == "Expense" ? "text-danger" : "text-success")">
                                @item.FormattedAmount
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="text-center py-4 rounded-3" style="background-color: #212b36; color: #6c757d;">
        <i class="fa-solid fa-receipt fs-2 mb-2 opacity-25"></i>
        <p class="small">No transactions found for this account.</p>
    </div>
}