@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="widget p-5" style="background-color:#212b36">

            <div class="mb-4">
                <h3 class="fw-bold">Welcome Back</h3>
                <span class="text-muted">Please login to continue</span>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Email</label>
                    <input type="email" name="email" class="form-control" required style="background-color:#1a222b; border: 1px solid #343a40; color:white;" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Password</label>
                    <input type="password" name="password" class="form-control" required style="background-color:#1a222b; border: 1px solid #343a40; color:white;" />
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-success btn-lg fw-bold">Login</button>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <span class="text-muted small">New User?</span>
                    <a href="/Account/Register" class="btn btn-outline-secondary btn-sm text-white border-0" style="background-color:#343a40">
                        Create Account
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>