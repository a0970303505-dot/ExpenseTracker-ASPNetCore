@model IEnumerable<expense_tracker.Models.Budget>
@using System.Globalization

@{
    ViewData["PageTitle"] = "Budget History";
}

<div class="row mb-4">
    <div class="col-md-12">
        <div class="widget p-4" style="background-color:#212b36">
            <h5 class="fw-bold mb-3">Search Budgets</h5>
            <form asp-controller="Budget" asp-action="History" method="get" style="max-width: 500px;">
                <div class="input-group">
                    <input type="text" name="searchQuery" class="form-control shadow-none" placeholder="Search Category..."
                           style="background-color: #1a222b; color: #fff; border: 1px solid #444;" />
                    <button type="submit" class="btn btn-primary px-4 shadow-none">
                        <i class="fa-solid fa-magnifying-glass"></i> Search
                    </button>
                    <a href="/Budget/History" class="btn btn-outline-secondary shadow-none">Clear</a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="widget p-0" style="background-color:#212b36; min-height: 200px;">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table mb-0 align-middle">
                        <thead style="background-color: #1a222b;">
                            <tr style="border-bottom: 1px solid #343a40;">
                                <th class="py-3 ps-4 text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px; font-weight: 600;">
                                    Category
                                </th>
                                <th class="py-3 pe-4 text-end text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px; font-weight: 600;">
                                    Limit
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.OrderByDescending(x => x.BudgetMonth).GroupBy(x => x.BudgetMonth.ToString("MMM yyyy", new CultureInfo("en-US"))))
                            {
                                <tr class="group-header">
                                    <td colspan="2" class="py-2 ps-4" style="background-color: #252d36; border-bottom: 1px solid #2c3e50;">
                                        <div class="d-flex align-items-center">
                                            <i class="fa-solid fa-calendar-days me-2 text-info"></i>

                                            <span class="text-white fw-bold" style="font-size: 0.95rem; letter-spacing: 0.5px;">
                                                @group.Key
                                            </span>

                                            <span class="ms-2 badge rounded-pill bg-dark text-muted border border-secondary" style="font-size: 0.7rem;">
                                                @group.Count() items
                                            </span>
                                        </div>
                                    </td>
                                </tr>

                                @foreach (var item in group)
                                {
                                    <tr class="data-row" style="border-bottom: 1px solid #2c3e50;">
                                        <td class="py-3 ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box bg-dark rounded-circle d-flex align-items-center justify-content-center me-3"
                                                     style="width:32px; height:32px; font-size:0.9rem; border: 1px solid #343a40;">
                                                    @item.Category.Icon
                                                </div>
                                                <span class="text-white" style="font-size: 0.9rem;">@item.Category.Title</span>
                                            </div>
                                        </td>
                                        <td class="py-3 pe-4 text-end">
                                            <span class="fw-bold text-success" style="font-size: 0.9rem;">@item.Amount.ToString("C0")</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-folder-open fa-2x mb-3 opacity-50"></i>
                    <p>No budgets found matching your criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    
    .data-row:hover {
        background-color: #313c48;
        transition: background-color 0.2s;
    }

    
    .table > :not(caption) > * > * {
        border-bottom-color: #2c3e50;
    }
</style>