@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="widget p-5" style="background-color:#212b36">

            <div class="mb-4">
                <h3 class="fw-bold">Create Account</h3>
                <span class="text-muted">Join us to manage your expenses</span>
            </div>

            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Full Name</label>
                    <input type="text" name="fullName" class="form-control" required placeholder="e.g. Shin Chan" style="background-color:#1a222b; border: 1px solid #343a40; color:white;" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Email</label>
                    <input type="email" name="email" class="form-control" required style="background-color:#1a222b; border: 1px solid #343a40; color:white;" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Password</label>
                    <input type="password" name="password" class="form-control" required style="background-color:#1a222b; border: 1px solid #343a40; color:white;" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold">Profile Picture</label>
                    <input type="file" name="profilePicture" class="form-control" accept="image/*" style="background-color:#1a222b; border: 1px solid #343a40; color:white;" />
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg fw-bold">Register</button>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <span class="text-muted small me-2">Already have an account?</span>
                    <a href="/Account/Login" class="text-decoration-none text-info fw-bold">Login</a>
                </div>
            </form>
        </div>
    </div>
</div>