@model IEnumerable<expense_tracker.Models.Account>

@{
    ViewData["Title"] = "My Wallet";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h3 class="fw-bold text-white">💰 My Accounts</h3>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="AddOrEdit" class="btn btn-success shadow-none">
            <i class="fa-solid fa-plus"></i> New Account
        </a>
    </div>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0" style="background-color: #212b36; border-radius: 15px;">
                <div class="card-body d-flex flex-column justify-content-between">

                    <div class="d-flex align-items-center mb-3">
                       
                        <div class="fs-1 me-3 p-3 rounded-circle d-flex align-items-center justify-content-center"
                             style="background-color: #1a222b; width: 80px; height: 80px; color: #fff;">
                            @item.Icon
                        </div>
                        <div>
                            <h5 class="card-title mb-1 fw-bold text-white">@item.Title</h5>
                            <small class="text-white-50">Balance</small>
                            @* 判斷：如果大於等於0就用 success(綠)，不然就用 danger(紅) *@
                            <h3 class="fw-bold @(item.Balance >= 0 ? "text-success" : "text-danger") mb-0">
                                @item.Balance.ToString("C0")
                            </h3>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3 pt-3" style="border-top: 1px solid #2c3e50;">
                        <a asp-action="Details" asp-route-id="@item.AccountId" class="btn btn-outline-info btn-sm flex-grow-1 me-2 rounded-pill">
                            <i class="fa-solid fa-list-ul"></i> Transactions
                        </a>
                        <a asp-action="AddOrEdit" asp-route-id="@item.AccountId" class="btn btn-outline-secondary btn-sm me-2 rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.AccountId" onsubmit="return confirm('Are you sure to delete this account? All related transactions will be deleted too.')" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    }
</div>